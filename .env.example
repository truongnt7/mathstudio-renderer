# mathstudio-renderer environment example
# Copy to .env and fill in values for local development
# NEVER commit .env to version control

# Render configuration
RENDERER_OUTPUT_DIR=./output
RENDERER_WORKSPACE_DIR=./workspace
RENDERER_DEFAULT_TIMEOUT=120
RENDERER_LOG_LEVEL=INFO
RENDERER_LOG_FORMAT=json

# Resource limits (enforced by Docker Compose)
# RENDERER_MAX_MEMORY=4g
# RENDERER_MAX_CPUS=4

# Development overrides
# RENDERER_LOG_FORMAT=text
